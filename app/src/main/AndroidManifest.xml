<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- EV Remote: wake the car at exact times while it charges (Android's Doze would delay normal background work) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets LionFlow set a phone alarm for when the car reaches the charge target -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Route tracking (optional, off by default) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- EV Remote: not used (voice search and Android Auto are hidden); also removed if a library adds them -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" tools:node="remove" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_SPEED" tools:node="remove" />
    <uses-permission android:name="com.google.android.gms.permission.CAR_FUEL" tools:node="remove" />

    <application
        android:name=".LionFlowApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LionFlow">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Sign-in returns here: mymap (Peugeot), mymacsdk (Citroen), mymdssdk (DS), mymopsdk (Opel), mymvxsdk (Vauxhall), then oauth2redirect/country?code=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mymap" android:host="oauth2redirect" />
                <data android:scheme="mymacsdk" android:host="oauth2redirect" />
                <data android:scheme="mymdssdk" android:host="oauth2redirect" />
                <data android:scheme="mymopsdk" android:host="oauth2redirect" />
                <data android:scheme="mymvxsdk" android:host="oauth2redirect" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.CarWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Route tracking: notices when the phone connects to the car's Bluetooth -->
        <receiver
            android:name=".route.CarBluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".route.RouteService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- EV Remote: exact alarm that wakes the car while it charges (work/ChargeWake.kt) -->
        <receiver
            android:name=".work.ChargeWakeReceiver"
            android:exported="false" />
        <!-- EV Remote: expedited background work runs as a short foreground service on Android 8–11 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- EV Remote: Android Auto (LionFlowCarService) is not registered; the code in car/ is kept for upstream merges -->


        <!-- Answers LionFlow on a Wear OS watch (same package + signing key only) -->
        <service
            android:name=".wear.WearService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/lionflow" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
